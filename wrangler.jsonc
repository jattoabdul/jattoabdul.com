{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jattoabdul-cinematic-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jattoabdul-cinematic-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "jattoabdul-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "jattoabdul-staging"
        }
      ],
      "vars": {
        "SITE_ENV": "staging",
        "SEO_INDEXABLE": "false",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      }
    },
    "production": {
      "name": "jattoabdul-production",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "jattoabdul.com/*",
          "zone_id": "ad3961ea9aeffc0b75f9aa0fa8baf189"
        },
        {
          "pattern": "www.jattoabdul.com/*",
          "zone_id": "ad3961ea9aeffc0b75f9aa0fa8baf189"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "jattoabdul-production"
        }
      ],
      "vars": {
        "SITE_ENV": "production",
        "SEO_INDEXABLE": "true",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      }
    }
  }
}
